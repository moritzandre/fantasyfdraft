---
// The PWA shell. The live board is fully client-side by design (plan: "Live
// iPad app"), so Astro's zero-JS default is deliberately bypassed here with
// client:only — LiveApp boots board.json, the store and the hash router
// (#/ready · #/setup · #/live) itself.
import AppLayout from '../layouts/AppLayout.astro';
import LiveApp from '../components/live/LiveApp';
---

<AppLayout>
  <LiveApp client:only="preact" />
  <noscript>
    <p style="padding:2rem;text-align:center">
      DraftPrep needs JavaScript — or use the printed kit in your bag.
    </p>
  </noscript>
</AppLayout>
